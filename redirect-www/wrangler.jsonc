{
  // Tiny Worker that permanently redirects www.furkancomoglu.dev -> furkancomoglu.dev.
  // Deploy: npm run deploy:www
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "furkancomoglu-dev-www",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.furkancomoglu.dev", "custom_domain": true }]
}
