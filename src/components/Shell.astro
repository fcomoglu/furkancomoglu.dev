---
import { profile } from "../data/profile";
---

<div class="shell" data-shell hidden role="dialog" aria-modal="true" aria-label="Interactive shell">
  <div class="shell-win">
    <div class="shell-bar mono">
      <span>{profile.user}@{profile.host}: ~ (zsh)</span>
      <button type="button" data-shell-close aria-label="Close shell">esc ✕</button>
    </div>
    <div class="shell-out mono" data-shell-out aria-live="polite"></div>
    <form class="shell-in mono" data-shell-form autocomplete="off">
      <label for="shell-input"><span class="accent">➜</span> <span class="cyan">~</span></label>
      <input id="shell-input" type="text" spellcheck="false" autocapitalize="off" />
    </form>
  </div>
</div>

<style>
  .shell {
    position: fixed;
    inset: 0;
    z-index: 60; /* below the CRT overlay so the shell sits "inside" the monitor */
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(16px, 8vh, 96px) 16px 16px;
  }
  .shell[hidden] { display: none; }
  .shell-win {
    width: min(760px, 100%);
    max-height: min(560px, 100%);
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.8);
    animation: drop 0.18s ease-out;
  }
  @keyframes drop { from { transform: translateY(-12px); opacity: 0; } }
  .shell-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    font-size: 12px;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .shell-bar button {
    background: none;
    border: 0;
    color: var(--faint);
    font: inherit;
    cursor: pointer;
  }
  .shell-bar button:hover { color: var(--text); }
  .shell-out {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px 0;
    font-size: 13.5px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .shell-out :global(p) { margin: 0; }
  .shell-out :global(a) { color: var(--cyan); text-decoration: underline; text-underline-offset: 2px; }
  .shell-in {
    display: flex;
    gap: 10px;
    padding: 10px 16px 16px;
    font-size: 13.5px;
  }
  .shell-in input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    caret-color: var(--accent);
  }
</style>
