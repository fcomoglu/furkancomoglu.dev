---
import SectionHead from "./SectionHead.astro";
import { experience } from "../data/profile";
---

<section class="section wrap" id="experience">
  <SectionHead
    num="04"
    cmd="git log --graph --oneline career"
    title="Experience"
    lede="Sixteen years of commits, from first internship to senior engineer."
  />

  <ol class="log mono">
    {
      experience.map((r) => (
        <li class="commit reveal">
          <div class="graph" aria-hidden="true">
            <span class="node">*</span>
          </div>
          <div class="body">
            <p class="head">
              <span class="amber">commit {r.hash}</span>{" "}
              <span class="refs">
                {r.head && <span class="ref head">HEAD → main</span>}
                <span class="ref tag">tag: {r.tag}</span>
              </span>
            </p>
            <p class="faint date">Date: {r.period} · {r.location}</p>
            <h3>
              {r.title} <span class="muted">@</span> <span class="accent">{r.company}</span>
            </h3>
            <ul>
              {r.highlights.map((h) => (
                <li>
                  <span class="hl">{h.title}.</span> {h.body}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13.5px;
  }
  .commit {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 8px;
  }
  .graph {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .graph::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--line-2);
  }
  .commit:first-child .graph::before { top: 10px; }
  .commit:last-child .graph::before { bottom: auto; height: 10px; }
  .node {
    position: relative;
    color: var(--accent);
    background: var(--bg);
    line-height: 20px;
    font-weight: 700;
  }
  .body {
    padding-bottom: 36px;
    min-width: 0;
  }
  .head { margin: 0; line-height: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; }
  .refs { display: inline-flex; gap: 6px; }
  .ref {
    font-size: 11.5px;
    line-height: 1.5;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 4px;
    padding: 0 7px;
  }
  .ref.head {
    background: var(--accent);
    color: var(--bg);
    text-shadow: none;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.45);
  }
  .ref.tag { border-color: var(--warm); color: var(--warm); }
  .date { margin: 2px 0 12px; }
  h3 {
    font-family: var(--display);
    font-size: clamp(18px, 2.4vw, 22px);
    font-weight: 600;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
    border-left: 1px dashed var(--line-2);
    display: grid;
    gap: 8px;
  }
  li {
    font-family: var(--sans);
    font-size: 15px;
    color: var(--muted);
    max-width: 780px;
  }
  .hl { color: var(--text); font-weight: 550; }
</style>
