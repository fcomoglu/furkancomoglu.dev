---
import { profile } from "../data/profile";
const prompt = `${profile.user}@${profile.host}`;
const parts = profile.name.split(" ");
const last = parts.pop() ?? "";
const first = parts.join(" ");
---

<section class="hero wrap" id="top">
  <div class="term panel reveal">
    <div class="term-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="term-title mono">{prompt}: ~ (zsh)</span>
      <span class="term-hint mono faint">type <span class="accent">help</span></span>
    </div>
    <div class="term-body mono">
      <p class="line"><span class="accent">➜</span> <span class="cyan">~</span> whoami</p>
      <p class="line out">{profile.role} · {profile.location}</p>

      <h1 class="name" aria-label={profile.name} data-typewriter><span data-type>{`${first} `}</span><span class="l2" data-type>{last}</span><span class="caret" aria-hidden="true"></span></h1>

      <p class="tagline">
        {profile.tagline.map((t, i) => <>{i > 0 && <span class="faint"> · </span>}<span>{t}</span></>)}
      </p>

      <p class="lede">{profile.lede}</p>

      <form class="prompt" data-hero-prompt autocomplete="off">
        <label for="hero-input"><span class="accent">➜</span> <span class="cyan">~</span></label>
        <input id="hero-input" name="cmd" type="text" spellcheck="false" placeholder="help" aria-label="Run a shell command" />
      </form>
    </div>
  </div>

  <dl class="stats">
    {
      profile.stats.map((s, i) => (
        <div class="stat reveal" style={`transition-delay:${i * 80}ms`}>
          <dt class="mono">
            {s.value.endsWith("+") ? (
              <>
                {s.value.slice(0, -1)}
                <span class="plus">+</span>
              </>
            ) : (
              s.value
            )}
          </dt>
          <dd>{s.label}</dd>
        </div>
      ))
    }
  </dl>

  <p class="avail mono reveal"><span class="pulse" aria-hidden="true"></span>{profile.availability}</p>
</section>

<style>
  .hero {
    padding-top: clamp(32px, 7vw, 80px);
  }
  .term {
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
    font-size: 12px;
  }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-2); display: block; }
  .dots i:nth-child(1) { background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .term-title { flex: 1; text-align: center; color: var(--muted); }
  .term-body {
    padding: clamp(20px, 4vw, 44px);
    font-size: 14px;
  }
  .line { margin: 0; color: var(--text); }
  .line.out { color: var(--muted); margin-bottom: 28px; }
  .name {
    font-family: var(--display);
    font-size: clamp(36px, 7.4vw, 84px);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 0 0 18px;
  }
  .l2 {
    color: var(--accent);
  }
  :global(:root:not([data-theme="light"])) .name .l2 {
    text-shadow: -1.2px 0 #ff2b786b, 1.2px 0 #00e5ff6b, 0 0 28px #00e5ff73;
  }
  /* thin terminal bar cursor: hard on/off, ~1s cycle */
  .caret {
    display: inline-block;
    width: 0.07em;
    min-width: 3px;
    height: 0.82em;
    margin-left: 0.1em;
    background: var(--warm);
    box-shadow: 0 0 14px color-mix(in srgb, var(--warm) 70%, transparent);
    vertical-align: -0.04em;
    animation: blink 1.06s step-end infinite !important;
  }
  /* solid while typing, like a real terminal */
  .caret.typing {
    animation: none !important;
    opacity: 1;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .tagline {
    margin: 0 0 18px;
    color: var(--amber);
    font-size: 14px;
  }
  .lede {
    font-family: var(--sans);
    font-size: clamp(17px, 2.2vw, 21px);
    color: var(--text);
    max-width: 680px;
    margin: 0 0 32px;
    line-height: 1.5;
  }
  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px dashed var(--line-2);
    padding-top: 18px;
  }
  .prompt label { white-space: nowrap; }
  .prompt input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    caret-color: var(--accent);
  }
  .prompt input::placeholder { color: var(--faint); }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    margin: 20px 0 0;
  }
  .stat {
    background: var(--panel);
    padding: 22px 24px;
    margin: 0;
  }
  .stat dt {
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
  }
  .stat dt .plus {
    color: var(--warm);
    text-shadow: var(--glow-warm);
  }
  .stat dd {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
  .avail {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted);
    margin: 20px 0 0;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2s infinite;
    flex: none;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    100% { box-shadow: 0 0 0 10px transparent; }
  }

  @media (max-width: 720px) {
    .stats { grid-template-columns: 1fr; }
    .term-hint { display: none; }
    .term-title { text-align: left; }
  }
</style>
