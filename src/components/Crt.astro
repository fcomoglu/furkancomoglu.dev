---
// CRT monitor overlay + power-on animation (driven by src/scripts/crt.ts)
---

<div class="crt" aria-hidden="true">
  <i class="crt-mask"></i><i class="crt-scan"></i><i class="crt-flicker"></i><i class="crt-pulse"></i><i class="crt-dim"></i>
</div>
<div class="crt-boot" aria-hidden="true">
  <canvas class="crt-noise" width="240" height="135"></canvas>
  <i class="crt-flash"></i>
</div>

<style is:global>
  .crt {
    pointer-events: none;
    z-index: 70;
    position: fixed;
    inset: 0;
  }
  .crt i {
    position: absolute;
    inset: 0;
    display: block;
  }
  /* bezel, vignette, edge glow */
  .crt::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 70px / 90px;
    background:
      radial-gradient(75% 70%, #8c78ff0b, #0000 70%),
      radial-gradient(90% 85%, #0000 55%, #010004b3 100%);
    box-shadow:
      0 0 0 120px #010004,
      inset 0 0 220px 30px #000000c7,
      inset 0 0 60px #0009,
      inset 0 0 3px 2px #00e5ff2e;
  }
  /* glass reflections */
  .crt::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 70px / 90px;
    background:
      radial-gradient(55% 35% at 24% 10%, #ece9ff17, #0000 70%),
      radial-gradient(30% 18% at 80% 92%, #ece9ff08, #0000 70%);
  }
  .crt-scan {
    background: repeating-linear-gradient(0deg, #0000003d 0 1px, #0000 1px 3px);
  }
  .crt-mask {
    background: repeating-linear-gradient(90deg, #ff286e08 0 1px, #00ffc805 1px 2px, #0000002b 2px 3px);
  }
  /* per-frame random flicker; opacity is set every frame by crt.ts */
  .crt-flicker {
    background: #00000012;
  }

  /* power-on */
  .crt-boot {
    z-index: 90;
    pointer-events: none;
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #000;
    /* fallback if the script never runs */
    animation: crt-boot-fallback 0.4s 2.6s forwards;
  }
  .crt-noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
    mix-blend-mode: screen;
  }
  .crt-flash {
    position: absolute;
    top: 10%;
    left: 0;
    right: 0;
    height: 80%;
    opacity: 0;
    background: radial-gradient(70% 60%, #fff, #d9fbff 45%, #8cf0ff8c 75%, #0000 100%);
    box-shadow: 0 0 120px 40px #00e5ff73;
  }
  @keyframes crt-boot-fallback {
    to { opacity: 0; visibility: hidden; }
  }

  /* chromatic aberration on big type */
  :root:not([data-theme="light"]) .name,
  :root:not([data-theme="light"]) .section-title,
  :root:not([data-theme="light"]) .mail {
    text-shadow:
      -1.2px 0 #ff2b785e,
      1.2px 0 #00e5ff5e,
      0 0 13px color-mix(in srgb, currentColor 30%, transparent);
  }

  /* brightness instability layers; crt.ts drifts their opacity continuously */
  .crt .crt-pulse {
    opacity: 0;
    background: radial-gradient(80% 75% at 50% 45%, #eef6ff, #c9f6ff 55%, #9fe9ff 100%);
    mix-blend-mode: screen;
  }
  .crt .crt-dim {
    opacity: 0;
    background: #000;
  }

  /* the effect belongs to the dark "monitor"; light theme stays clean */
  :root[data-theme="light"] .crt { display: none; }

  @media (max-width: 899px) {
    .crt::before,
    .crt::after { border-radius: 34px / 44px; }
    .crt::before {
      box-shadow:
        0 0 0 80px #010004,
        inset 0 0 90px 10px #000000b3,
        inset 0 0 2px 1px #00e5ff26;
    }
    .crt-scan { background: repeating-linear-gradient(0deg, #0003 0 1px, #0000 1px 3px); }
    .crt-mask { display: none; }
    /* flicker stays on mobile, slightly lighter (screen is held close to the eyes) */
    .crt-flicker { background: #0000000c; }
  }

</style>
